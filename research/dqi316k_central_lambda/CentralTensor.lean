def step (s : Array Lane) (g : Gate) : Array Lane :=
  let (cc,a,b,t) := g
  if cc then s.set! t (s[t]! ^^^ (s[a]! &&& s[b]!))
  else s.set! b (s[b]! ^^^ s[a]!)
