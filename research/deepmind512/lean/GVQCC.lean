-- Universal classical Boolean identities underlying GF(2) cache rewrites.
theorem xorInvolution (a b : Bool) : Bool.xor (Bool.xor a b) b = a := by
  cases a <;> cases b <;> decide

theorem xorFanout (t a b c : Bool) :
    Bool.xor (Bool.xor t (a && b)) (a && c) =
      Bool.xor t (a && Bool.xor b c) := by
  cases t <;> cases a <;> cases b <;> cases c <;> decide

theorem measurementPhaseLinear (m a b : Bool) :
    Bool.xor (m && Bool.xor a b)
      (Bool.xor (m && a) (m && b)) = false := by
  cases m <;> cases a <;> cases b <;> decide

