import Std.Tactic.BVDecide

/-!
Actual source 6b59214530108d8c49c648f96c53b963d9b8477f8813db1edcf478bf45f6cf03
and 16 serialized 36Q diagnostic segments. Source and candidate lists were
compared instruction-for-instruction against the pinned original KMB slices
and parsed candidate KMB bytes in the local experiment. Event numbers are
renumbered relative to the first event in each slice. The removed outcomes
are NORMALIZED to zero here, not universally discarded. Their observable
whole-program coefficients must separately be proved zero. Initial omitted
wire must be zero. No rotation gates occur in these slices. The equality is
on the entire 37-bit embedded state, local classical records and relative
phase, for arbitrary remaining quantum basis bits and retained outcome.
This is not a proof of the full oracle, physical numerical approximation,
or official score. No axioms or sorry.
-/
set_option maxRecDepth 65536
set_option maxHeartbeats 0
namespace GVQCC.ActualCarry

inductive Gate where
  | cx (a t : Nat)
  | ccx (a b t : Nat)
  | hmr (q j : Nat)
  | clearEvent (j : Nat)
  | push (j : Nat)
  | pop
  | z (q : Nat)
  | cz (a b : Nat)
  deriving DecidableEq, Repr

structure State where
  wires : BitVec 37
  phase : Bool
  classical : BitVec 8
  guard : Bool
  deriving DecidableEq, Repr

private def bit (s : BitVec 37) (i : Nat) : BitVec 37 := (s >>> i) &&& 1
private def xorWire (s : BitVec 37) (i : Nat) (v : BitVec 37) : BitVec 37 :=
  s ^^^ ((v &&& 1) <<< i)
private def zeroWire (s : BitVec 37) (i : Nat) : BitVec 37 :=
  s &&& ~~~((1 : BitVec 37) <<< i)
private def setEvent (s : BitVec 8) (j : Nat) (v : Bool) : BitVec 8 :=
  (s &&& ~~~((1 : BitVec 8) <<< j)) ||| ((if v then 1 else 0) <<< j)

private def tick (m : Bool) (s : State) : Gate → State
  | .cx a t => { s with wires := xorWire s.wires t (bit s.wires a) }
  | .ccx a b t => { s with wires := xorWire s.wires t (bit s.wires a &&& bit s.wires b) }
  | .hmr q j =>
    let v := if j == 0 then m else false
    { s with wires := zeroWire s.wires q,
             phase := Bool.xor s.phase (v && (bit s.wires q).getLsbD 0),
             classical := setEvent s.classical j v }
  | .clearEvent j => { s with classical := setEvent s.classical j false }
  | .push j => { s with guard := s.classical.getLsbD j }
  | .pop => { s with guard := true }
  | .z q => { s with phase := Bool.xor s.phase (s.guard && (bit s.wires q).getLsbD 0) }
  | .cz a b => { s with phase := Bool.xor s.phase (s.guard && (bit s.wires a &&& bit s.wires b).getLsbD 0) }

private def run (gs : List Gate) (m : Bool) (s : State) : State :=
  gs.foldl (tick m) s

private def sourceInput (s : BitVec 37) (d : Nat) : BitVec 37 := zeroWire s d
private def candidateInput (s : BitVec 37) (d : Nat) : BitVec 37 :=
  if d == 36 then zeroWire s 36
  else xorWire (zeroWire (zeroWire s d) 36) d (bit s 36)

private def paid : List Gate → Nat
  | [] => 0
  | .ccx _ _ _ :: gs => 1 + paid gs
  | _ :: gs => paid gs

private def wireOK (n : Nat) : Gate → Bool
  | .cx a t => decide (a < n ∧ t < n ∧ a ≠ t)
  | .ccx a b t => decide (a < n ∧ b < n ∧ t < n ∧ a ≠ b ∧ a ≠ t ∧ b ≠ t)
  | .hmr q j => decide (q < n ∧ j < 8)
  | .clearEvent j | .push j => decide (j < 8)
  | .pop => true
  | .z q => decide (q < n)
  | .cz a b => decide (a < n ∧ b < n ∧ a ≠ b)

-- No nested guard or conditional basis gates are permitted in this subset.
private def validSchedule (n : Nat) (active : Bool) : List Gate → Bool
  | [] => !active
  | g :: gs => wireOK n g &&
    (match g with
     | .push _ => !active && validSchedule n true gs
     | .pop => active && validSchedule n false gs
     | .z _ | .cz _ _ => active && validSchedule n active gs
     | _ => !active && validSchedule n false gs)

