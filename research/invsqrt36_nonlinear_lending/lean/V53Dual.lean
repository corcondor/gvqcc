def bit (a : Bool) : Int := if a then 1 else 0
theorem xor_bilinear (a b : Bool) :
    bit (Bool.xor a b) = bit a + bit b - 2 * bit a * bit b := by
  cases a <;> cases b <;> decide
theorem complement_product (a b : Bool) :
    bit (a && !b) = bit a - bit a * bit b := by
  cases a <;> cases b <;> decide
