namespace GVQCC.V53
structure Row where
  mask : Nat
  sign : Int
  weight : Nat
  rhs : Int
  deriving Repr
def cancellation (r : List Row) (j : Nat) : Int :=
  r.foldl (fun a x => a + (if x.mask.testBit j then x.sign * Int.ofNat x.weight else 0)) 0
def rhs (r : List Row) : Int :=
  r.foldl (fun a x => a + Int.ofNat x.weight * x.rhs) 0
def weight (r : List Row) : Nat :=
  r.foldl (fun a x => a + x.weight) 0
def cancelled (r : List Row) (n : Nat) : Bool :=
  (List.range n).all (fun j => cancellation r j == 0)
