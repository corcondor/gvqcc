theorem coverage : 55829 + 355 = 56184 ∧ 60766 - 56184 = 4582 := by decide
-- Arithmetic hypothesis: two redundant low residual bits after binary digit extension.
-- These are integer identities, not a synthesized 36Q circuit.
theorem residual_one (p r k u : Int) :
    4*r - (4*p + (4*k+u)) = 4*(r-p-k-1)+(4-u) := by omega
theorem residual_zero (r : Int) : 4*r = 4*r+0 := by omega
theorem residual_sign (s ell : Int) (h0 : 0 ≤ ell) (h1 : ell < 4) :
    0 ≤ 4*s+ell ↔ 0 ≤ s := by omega
theorem recover_digit (p k : Int) : (2*p+(2*k+1)) % 2 = 1 := by omega
theorem low_residue (s u : Int) (h : u = 1 ∨ u = 3) :
    (4*s+(4-u)) % 4 = 4-u := by omega
