def cubeIdx : List Nat := [5,7,35,85,97,98,105,109]
def cubeRows : List Nat := cubeIdx.map (fun i => rows[i]!)
def parity (xs : List Bool) : Bool := xs.foldl Bool.xor false
def colParity (i : Nat) : Bool := parity (cubeRows.map (fun r => r.testBit i))
def monParity (i j : Nat) : Bool :=
  parity (cubeRows.map (fun r => r.testBit i && r.testBit j))
theorem row_count : rows.length = 117 := by native_decide
theorem constant_column : rows.all (fun r => r.testBit 0) = true := by native_decide
theorem actual_cube_low_coordinates :
    cubeRows.map (fun r => r % (2^37)) =
      [60068548883,124492009971,21413843223,60068548891,21413843231,94427238903,124492009979,94427238911] := by native_decide
-- Includes constant and all linear monomials (column 0 is constant 1).
theorem annihilates_degree_two :
    (List.range 37).all (fun i =>
      (List.range 37).all (fun j => !(monParity i j))) = true := by native_decide
theorem shared_products_with_nonzero_third_difference :
    (List.range 80).filter (fun j => colParity (37+j)) =
      [42,49,54,55,61,62,74,77] := by native_decide
theorem actual_cubic_atom :
    parity (cubeRows.map (fun r => r.testBit 2 && r.testBit 3 && r.testBit 5)) = true := by native_decide
theorem nand_candidate_on_sample :
    rows.all (fun r => r.testBit 36 == !(r.testBit 20 && r.testBit 26)) = true := by native_decide
-- Universal gate identity, assuming the NAND relation at a reachable cut.
theorem nand_clear (a b : Bool) :
    Bool.xor (Bool.xor (!(a && b)) true) (a && b) = false := by
  cases a <;> cases b <;> decide
-- HMR Z-basis sign exponent plus classically controlled CZ = branch-global m.
-- This is a Boolean phase identity, not a native instrument proof.
theorem nand_hmr_phase (a b m : Bool) :
    Bool.xor (m && !(a && b)) (m && (a && b)) = m := by
  cases a <;> cases b <;> cases m <;> decide
end GVQCC.CarryCube
