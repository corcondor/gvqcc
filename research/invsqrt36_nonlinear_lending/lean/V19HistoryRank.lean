def xorRows (xs : List Nat) (v : Nat) : Nat :=
  (List.range xs.length).foldl (fun a i =>
    if v.testBit i then Nat.xor a xs[i]! else a) 0

-- Every standard coordinate vector is a combination of the actual rows.
-- This verifies an explicit inverse, not a numerical rank estimate.
theorem actual_matrix_spans :
    (List.range 115).all (fun i =>
      xorRows rows inverseCombinations[i]! == 2^i) = true := by native_decide

theorem witness_dimensions :
    rows.length = 115 ∧ inverseCombinations.length = 115 ∧
    legalInputs.length = 115 ∧ eventOrdinals.length = 115 ∧
    legalInputs.all (fun x => decide (1 ≤ x ∧ x ≤ 3133452)) = true := by native_decide

theorem paired_phase (m f p : Bool) :
    Bool.xor (Bool.xor p (m && f)) (m && f) = p := by
  cases m <;> cases f <;> cases p <;> decide
end GVQCC.V19HistoryRank
