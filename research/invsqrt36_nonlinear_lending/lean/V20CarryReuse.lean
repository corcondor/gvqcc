def xorRows (xs : List Nat) (v : Nat) : Nat :=
  (List.range xs.length).foldl (fun a i =>
    if v.testBit i then Nat.xor a xs[i]! else a) 0
theorem actual_matrix_spans :
    (List.range 117).all (fun i =>
      xorRows rows inverseCombinations[i]! == 2^i) = true := by native_decide
theorem dimensions : rows.length = 117 ∧ inverseCombinations.length = 117 := by native_decide

def carry (a b c : Bool) : Bool := Bool.xor c (Bool.xor a c && Bool.xor b c)
theorem carry_majority (a b c : Bool) :
    carry a b c = ((a && b) || (a && c) || (b && c)) := by
  cases a <;> cases b <;> cases c <;> decide
theorem carry_difference (a b c : Bool) :
    (Bool.xor a c && Bool.xor b c) = Bool.xor c (carry a b c) := by
  cases a <;> cases b <;> cases c <;> decide
theorem two_edges (c0 c1 c2 : Bool) :
    Bool.xor (Bool.xor c0 c1) (Bool.xor c1 c2) = Bool.xor c0 c2 := by
  cases c0 <;> cases c1 <;> cases c2 <;> decide
theorem one_bit_three_tags (u v w : Bool) : u = v ∨ u = w ∨ v = w := by
  cases u <;> cases v <;> cases w <;> decide
theorem conditional_budget : 22581 - 80*16 = 21301 := by decide
