import Std.Tactic.BVDecide

/-! Actual PR30 encoded chart transitions across the nine 50-op gaps of
invsqrt source sha256 6b59214530108d8c49c648f96c53b963d9b8477f8813db1edcf478bf45f6cf03.
Single common HMR outcome m; following Z/CZ gates are controlled by m.
Input q14=0, all other 35 wires arbitrary. No assumptions on those bits.
The concrete lists are the reference decode+gap+encode and emitted two-shear gates.
This is local equivalence, not whole-oracle or official score certification. -/
set_option maxRecDepth 65536
set_option maxHeartbeats 0
namespace GVQCC.JointHubTransport
inductive Gate where
  | x (q : Nat)
  | cx (a t : Nat)
  | ccx (a b t : Nat)
  | swap (a b : Nat)
  | hmr (q : Nat)
  | zIf (q : Nat)
  | czIf (a b : Nat)
  deriving DecidableEq, Repr
structure State where
  wires : BitVec 36
  phase : Bool
  deriving DecidableEq, Repr
private def bit (s : BitVec 36) (i : Nat) : BitVec 36 := (s >>> i) &&& 1
private def xorWire (s : BitVec 36) (i : Nat) (v : BitVec 36) : BitVec 36 :=
  s ^^^ ((v &&& 1) <<< i)
private def zeroWire (s : BitVec 36) (i : Nat) : BitVec 36 :=
  s &&& ~~~((1 : BitVec 36) <<< i)
private def tick (m : Bool) (s : State) : Gate → State
  | .x q => {s with wires := xorWire s.wires q 1}
  | .cx a t => {s with wires := xorWire s.wires t (bit s.wires a)}
  | .ccx a b t => {s with wires := xorWire s.wires t (bit s.wires a &&& bit s.wires b)}
  | .swap a b =>
    let v := bit s.wires a ^^^ bit s.wires b
    {s with wires := xorWire (xorWire s.wires a v) b v}
  | .hmr q => {wires := zeroWire s.wires q, phase := Bool.xor s.phase (m && (bit s.wires q).getLsbD 0)}
  | .zIf q => {s with phase := Bool.xor s.phase (m && (bit s.wires q).getLsbD 0)}
  | .czIf a b => {s with phase := Bool.xor s.phase (m && (bit s.wires a &&& bit s.wires b).getLsbD 0)}
private def run (g : List Gate) (m : Bool) (s : State) := g.foldl (tick m) s
private def paid : List Gate → Nat
  | [] => 0
  | .ccx _ _ _ :: gs => 1 + paid gs
  | _ :: gs => paid gs
private def wireOK : Gate → Bool
  | .x q | .hmr q | .zIf q => decide (q < 36)
  | .cx a b | .swap a b | .czIf a b => decide (a < 36 ∧ b < 36 ∧ a ≠ b)
  | .ccx a b t => decide (a < 36 ∧ b < 36 ∧ t < 36 ∧ a ≠ b ∧ a ≠ t ∧ b ≠ t)
private def hmrCount : List Gate → Nat
  | [] => 0
  | .hmr _ :: gs => 1 + hmrCount gs
  | _ :: gs => hmrCount gs

