def paid : List Gate → Nat
  | [] => 0
  | .ccx _ _ _ :: gs => 1 + paid gs
  | _ :: gs => paid gs
def wireOK : Gate → Bool
  | .x t => decide (t < 36)
  | .cx a b => decide (a < 36) && decide (b < 36) && a != b
  | .ccx a b t => decide (a < 36) && decide (b < 36) && decide (t < 36) && a != b && a != t && b != t
  | .swap a b => decide (a < 36) && decide (b < 36) && a != b
set_option maxRecDepth 20000 in
set_option maxHeartbeats 0 in
theorem concrete_equivalence (s : BitVec 36) : run old s = run new s := by
  simp only [old, new, run, List.foldl_cons, List.foldl_nil, step, bit, xorWire]
  bv_decide
theorem old_cost : paid old = 3 := by decide
theorem new_cost : paid new = 1 := by decide
theorem old_length : old.length = 79 := by decide
theorem new_length : new.length = 110 := by decide
theorem new_width : new.all wireOK = true := by decide
#print axioms concrete_equivalence
